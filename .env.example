# Copy to .env if you want local overrides. The server reads the environment
# directly. Nothing here is a secret.
PORT=8080
HACKHEAT_HOST=0.0.0.0
# Freeze the clock for a repeatable demo. Leave empty for a live countdown.
# HACKHEAT_NOW=2026-10-25T03:34:00+00:00
# HACKHEAT_BOARD=data/opportunities.json
# After a Cloud Run deploy, the public origin goes here for the Duo HTTP MCP snippet.
# HACKHEAT_PUBLIC_URL=https://hack-heat-live-xxxxx.asia-southeast1.run.app

# Bounty jar, PayPal SANDBOX only. developer.paypal.com → Apps & Credentials →
# Sandbox → your REST app. Values go in your shell or Vercel env, never in git.
# Without them the jar shows a "Sandbox keys not configured" demo state.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# Pledge store. Default var/bounties.json. ":memory:" keeps it in RAM (Vercel does this automatically).
# HACKHEAT_BOUNTY_STORE=
